# Copy this file to `.env` and adjust the values.

# SQLite (local dev)
DATABASE_URL="file:./dev.db"
# PostgreSQL (production)
# DATABASE_URL="postgresql://user:password@localhost:5432/balaji_app?schema=public"

# Single admin account
ADMIN_USERNAME="Kunal"
ADMIN_PASSWORD="Kunal@123"

# Session signing secret (min 32 chars) — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
