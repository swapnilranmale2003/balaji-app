// Team Expense Tracker — Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Trip {
  id          String    @id @default(cuid())
  name        String    @unique
  description String    @default("")
  /// Funds collected for this trip. Editable; the balance derives from it.
  received    Float     @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  expenses Expense[]

  @@index([startDate])
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String
  amount      Float
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Every expense belongs to a trip. Deleting a trip removes its expenses
  // along with it — the trip is the unit of accounting.
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([category])
  @@index([tripId])
}
